---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import Button from "@/components/ui/Button.astro";
import { getCatalogSnapshot, type TaxonomyItem } from "@/lib/catalog/projects";
import { toProjectCardViewModels } from "@/lib/catalog/project-view-models";

export async function getStaticPaths() {
  const { taxonomy } = await getCatalogSnapshot();
  return taxonomy.tags.map((tag) => ({
    params: { tag: tag.id },
    props: { tag }
  }));
}

const { tag } = Astro.props as { tag: TaxonomyItem };
const { site, taxonomy, projectsByTag } = await getCatalogSnapshot();
const projects = projectsByTag.get(tag.id) ?? [];
const projectItems = toProjectCardViewModels(projects, taxonomy);
---

<BaseLayout title={`${tag.name} - GitHub Gallery`} site={site} description={tag.description}>
  <PageHeader
    eyebrow="Tag"
    title={tag.name}
    description={tag.description ?? "Projects grouped by tag."}
    variant="filter"
    asideLabel="Tag summary and actions"
    stats={[{ value: projects.length, label: "Projects" }]}
  >
    <Fragment slot="actions">
      <Button href="/" variant="outline">All projects</Button>
    </Fragment>
  </PageHeader>
  <ProjectCollection
    id={`tag-${tag.id}`}
    title={`${tag.name} projects`}
    items={projectItems}
    emptyMessage="No projects with this tag yet."
  />
</BaseLayout>
