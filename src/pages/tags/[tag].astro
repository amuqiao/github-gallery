---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import Button from "@/components/ui/Button.astro";
import { getCatalogSnapshot, type LocalizedTaxonomyItem } from "@/lib/catalog/projects";
import { toProjectCardViewModels } from "@/lib/catalog/project-view-models";
import { getActivePresentation } from "@/presentation";

export async function getStaticPaths() {
  const { taxonomy } = await getCatalogSnapshot();
  return taxonomy.tags.map((tag) => ({
    params: { tag: tag.id },
    props: { tag }
  }));
}

const { tag } = Astro.props as { tag: LocalizedTaxonomyItem };
const { site, taxonomy, projectsByTag } = await getCatalogSnapshot();
const projects = projectsByTag.get(tag.id) ?? [];
const projectItems = toProjectCardViewModels(projects, taxonomy);
const { layout } = getActivePresentation();
---

<BaseLayout title={`${tag.label} - GitHub Gallery`} site={site} description={tag.descriptionText}>
  <Breadcrumbs
    items={[
      { label: "展馆", href: "/" },
      { label: "标签", href: "/#categories" },
      { label: tag.label }
    ]}
  />
  <PageHeader
    eyebrow="标签"
    title={tag.label}
    description={tag.descriptionText}
    variant="filter"
    asideLabel="标签统计和操作"
    stats={[{ value: projects.length, label: "项目" }]}
  >
    <Fragment slot="actions">
      <Button href="/" variant="outline">全部项目</Button>
    </Fragment>
  </PageHeader>
  <ProjectCollection
    id={`tag-${tag.id}`}
    title="项目"
    hint={`${projects.length} 个项目`}
    items={projectItems}
    emptyMessage="这个标签下暂无项目。"
    variant={layout.listPages.projectCollectionVariant}
  />
</BaseLayout>
