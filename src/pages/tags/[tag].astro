---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import { getCatalogSnapshot, type TaxonomyItem } from "@/lib/catalog/projects";

export async function getStaticPaths() {
  const { taxonomy } = await getCatalogSnapshot();
  return taxonomy.tags.map((tag) => ({
    params: { tag: tag.id },
    props: { tag }
  }));
}

const { tag } = Astro.props as { tag: TaxonomyItem };
const { taxonomy, projectsByTag } = await getCatalogSnapshot();
const projects = projectsByTag.get(tag.id) ?? [];
---

<BaseLayout title={`${tag.name} - GitHub Gallery`} description={tag.description}>
  <PageHeader
    eyebrow="Tag"
    title={tag.name}
    description={tag.description ?? "Projects grouped by tag."}
    variant="filter"
    asideLabel="Tag summary and actions"
    stats={[{ value: projects.length, label: "Projects" }]}
  >
    <Fragment slot="actions">
      <a class="button-link" href="/">All projects</a>
    </Fragment>
  </PageHeader>
  <ProjectCollection
    id={`tag-${tag.id}`}
    title={`${tag.name} projects`}
    projects={projects}
    taxonomy={taxonomy}
    emptyMessage="No projects with this tag yet."
  />
</BaseLayout>
