---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FilterPanel from "@/components/FilterPanel.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import Button from "@/components/ui/Button.astro";
import { getCatalogSnapshot } from "@/lib/catalog/projects";
import { toProjectCardViewModels } from "@/lib/catalog/project-view-models";

const { projects, site, taxonomy } = await getCatalogSnapshot();
const activeCategories = taxonomy.categories.filter((category) =>
  projects.some((project) => project.category === category.id)
);
const activeTags = taxonomy.tags.filter((tag) => projects.some((project) => project.tags.includes(tag.id)));
const projectItems = toProjectCardViewModels(projects, taxonomy);
---

<BaseLayout title="GitHub Gallery" site={site}>
  <PageHeader
    eyebrow="Curated GitHub Projects"
    title="GitHub Gallery"
    description="一个合同驱动的项目展馆：从中心页浏览项目，通过分类和标签筛选，再进入项目详情继续发现相关项目。"
    variant="gallery"
    statsLabel="Gallery stats"
    asideLabel="Gallery summary and actions"
    stats={[
      { value: projects.length, label: "Projects" },
      { value: activeCategories.length, label: "Categories" },
      { value: activeTags.length, label: "Active tags" }
    ]}
  >
    <Fragment slot="actions">
      <Button href="#projects">Browse projects</Button>
      <Button href="#categories" variant="outline">Browse filters</Button>
    </Fragment>
  </PageHeader>

  <FilterPanel categories={activeCategories} tags={activeTags} projects={projects} />

  <ProjectCollection
    id="projects"
    eyebrow="Collection"
    title="All projects"
    description="同一批项目通过稳定合同进入页面，卡片、筛选页和详情页都消费统一 read model。"
    items={projectItems}
  />
</BaseLayout>
