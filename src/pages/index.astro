---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCollectionCard from "@/components/ContentCollectionCard.astro";
import ContentItemCard from "@/components/ContentItemCard.astro";
import HallCard from "@/components/HallCard.astro";
import {
  getPublishedContentCollections,
  getPublishedContentItems,
  getPublishedContentItemsByHallAndKind
} from "@/lib/catalog/content";
import { getAllHalls } from "@/lib/catalog/halls";
import { getSiteConfig } from "@/lib/catalog/projects";

const [site, collections, halls, publishedItems, models] = await Promise.all([
  getSiteConfig(),
  getPublishedContentCollections(),
  getAllHalls(),
  getPublishedContentItems(),
  getPublishedContentItemsByHallAndKind("models", "ai_model")
]);
const itemCountByHall = publishedItems.reduce<Record<string, number>>((counts, item) => {
  counts[item.hall] = (counts[item.hall] ?? 0) + 1;
  return counts;
}, {});
---

<BaseLayout title="Gallery Platform" site={site}>
  <header class="platform-home" aria-labelledby="platform-title">
    <div class="platform-home__kicker">Gallery Platform</div>
    <div class="platform-home__intro">
      <h1 id="platform-title">面向资料收藏的<br /><em>多展馆入口</em></h1>
      <p>这里从 GitHub 项目展馆开始，逐步接入模型资料，并预留音乐与电影展馆。内容发布仍以合同、loader 和构建验证作为门禁。</p>
    </div>
    <div class="platform-home__actions">
      <a class="editorial-button editorial-button--dark" href="/halls/github/">进入 GitHub 展馆</a>
      <a class="editorial-button" href="/halls/models/">浏览模型展馆</a>
      <a class="editorial-button editorial-button--outline" href="/halls/github/collections/">查看专题</a>
    </div>
  </header>

  <section class="gallery-section" aria-labelledby="halls-title">
    <div class="editorial-section-head">
      <span class="editorial-section-head__index">01</span>
      <h2 class="editorial-section-head__title" id="halls-title">展馆入口</h2>
      <span class="editorial-section-head__hint">{halls.length} 个展馆</span>
    </div>
    <div class="hall-grid">
      {halls.map((hall) => <HallCard hall={hall} itemCount={itemCountByHall[hall.id]} />)}
    </div>
  </section>

  <section class="gallery-section" aria-labelledby="model-feature-title">
    <div class="editorial-section-head">
      <span class="editorial-section-head__index">02</span>
      <h2 class="editorial-section-head__title" id="model-feature-title">模型样例</h2>
      <span class="editorial-section-head__hint">{models.length} 个模型</span>
    </div>
    <div class="project-collection__grid project-collection__grid--standard">
      {models.slice(0, 3).map((item) => <ContentItemCard item={item} />)}
    </div>
  </section>

  <section class="gallery-section" id="collections" aria-labelledby="collections-heading">
    <div class="editorial-section-head">
      <span class="editorial-section-head__index">03</span>
      <h2 class="editorial-section-head__title" id="collections-heading">精选专题</h2>
      <span class="editorial-section-head__hint">{collections.length} 个专题</span>
    </div>
    <div class="collection-grid__grid collection-grid__grid--standard">
      {collections.map((collection) => <ContentCollectionCard collection={collection} />)}
    </div>
  </section>
</BaseLayout>
