---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockRenderer from "@/components/blocks/BlockRenderer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import Button from "@/components/ui/Button.astro";
import Prose from "@/components/ui/Prose.astro";
import { loadCollectionDetail } from "@/lib/catalog/details";
import { getPublicCollections, type Collection } from "@/lib/catalog/collections";
import { getCatalogSnapshot } from "@/lib/catalog/projects";
import { toCollectionProjectCardViewModels } from "@/lib/catalog/project-view-models";
import { getActivePresentation } from "@/presentation";
import { getPublicationStatusLabel } from "@/presentation/publication-status-labels";

export async function getStaticPaths() {
  const collections = await getPublicCollections();
  return collections.map((collection) => ({
    params: { id: collection.id },
    props: { collection }
  }));
}

const { collection } = Astro.props as { collection: Collection };
const { site, taxonomy } = await getCatalogSnapshot();
const projectItems = toCollectionProjectCardViewModels(collection, taxonomy);
const detail = await loadCollectionDetail(collection);
const DetailContent = detail?.Content;
const { layout } = getActivePresentation();
const publicationStatusLabel = getPublicationStatusLabel(collection.publication_status);
---

<BaseLayout title={`${collection.title} - GitHub Gallery`} site={site} description={collection.summary}>
  <article class="grid gap-6">
    <Breadcrumbs
      items={[
        { label: "展馆", href: "/" },
        { label: "专题", href: "/collections/" },
        { label: collection.title }
      ]}
    />
    <PageHeader
      eyebrow="专题"
      title={collection.title}
      description={collection.summary}
      variant="project"
      asideLabel="专题操作"
      stats={[
        { value: projectItems.length, label: "项目" },
        { value: publicationStatusLabel, label: "发布状态" }
      ]}
    >
      <Fragment slot="actions">
        <Button href="/collections/" variant="outline">全部专题</Button>
      </Fragment>
    </PageHeader>

    {
      detail && (
        <Prose>
          {DetailContent && <DetailContent />}
        </Prose>
      )
    }
    {
      collection.blocks.length > 0 && (
        <section class="content-blocks" aria-label="专题详情">
          {collection.blocks.map((block, index) => <BlockRenderer block={block} index={index} />)}
        </section>
      )
    }
    <ProjectCollection
      id="collection-projects"
      title="专题内项目"
      hint={`${projectItems.length} 个项目 · 人工策展顺序`}
      description="专题只决定项目出现的顺序和策展说明；项目事实仍来自 project.yaml。"
      items={projectItems}
      variant={layout.detailPages.projectCollectionVariant}
    />
  </article>
</BaseLayout>
