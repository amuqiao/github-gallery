---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CollectionGrid from "@/components/CollectionGrid.astro";
import PageHeader from "@/components/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { getPublicCollections } from "@/lib/catalog/collections";
import { getCatalogSnapshot } from "@/lib/catalog/projects";
import { getActivePresentation } from "@/presentation";

const [{ site }, collections] = await Promise.all([getCatalogSnapshot(), getPublicCollections()]);
const referencedProjectCount = new Set(
  collections.flatMap((collection) => collection.projectItems.map((item) => item.project.id))
).size;
const { layout } = getActivePresentation();
---

<BaseLayout title="专题 - GitHub 展馆" site={site}>
  <Breadcrumbs
    items={[
      { label: "GitHub 展馆", href: "/halls/github/" },
      { label: "专题" }
    ]}
  />
  <PageHeader
    eyebrow="专题"
    title="人工策展的项目专题"
    description="专题是人工整理的项目列表。它们只引用已有项目，不复制项目事实，适合沉淀声音克隆、多语言 TTS 等长期维护主题。"
    variant="filter"
    asideLabel="专题统计和操作"
    stats={[
      { value: collections.length, label: "专题" },
      { value: referencedProjectCount, label: "引用项目" }
    ]}
  >
    <Fragment slot="actions">
      <Button href="/halls/github/#projects" variant="outline">全部项目</Button>
    </Fragment>
  </PageHeader>

  <CollectionGrid
    title="全部专题"
    hint={`${collections.length} 个专题`}
    description="每个专题按手写顺序引用已有 GitHub 项目，删除或新增专题不会改变项目本体。"
    collections={collections}
    variant={layout.listPages.collectionGridVariant}
  />
</BaseLayout>
