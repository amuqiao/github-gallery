---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CollectionGrid from "@/components/CollectionGrid.astro";
import PageHeader from "@/components/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { getPublicCollections } from "@/lib/catalog/collections";
import { getCatalogSnapshot } from "@/lib/catalog/projects";

const [{ site }, collections] = await Promise.all([getCatalogSnapshot(), getPublicCollections()]);
const referencedProjectCount = new Set(
  collections.flatMap((collection) => collection.projectItems.map((item) => item.project.id))
).size;
---

<BaseLayout title="Collections - GitHub Gallery" site={site}>
  <PageHeader
    eyebrow="Collections"
    title="Curated project collections"
    description="专题是人工整理的项目列表。它们只引用已有项目，不复制项目事实，适合沉淀声音克隆、多语言 TTS 等长期维护主题。"
    variant="filter"
    asideLabel="Collection summary and actions"
    stats={[
      { value: collections.length, label: "Collections" },
      { value: referencedProjectCount, label: "Referenced projects" }
    ]}
  >
    <Fragment slot="actions">
      <Button href="/" variant="outline">All projects</Button>
    </Fragment>
  </PageHeader>

  <CollectionGrid
    title="All collections"
    description="每个专题按手写顺序引用已有 GitHub 项目，删除或新增专题不会改变项目本体。"
    collections={collections}
  />
</BaseLayout>
