---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import Button from "@/components/ui/Button.astro";
import { getCatalogSnapshot, type TaxonomyItem } from "@/lib/catalog/projects";
import { toProjectCardViewModels } from "@/lib/catalog/project-view-models";
import { getActivePresentation } from "@/presentation";

export async function getStaticPaths() {
  const { taxonomy } = await getCatalogSnapshot();
  return taxonomy.categories.map((category) => ({
    params: { category: category.id },
    props: { category }
  }));
}

const { category } = Astro.props as { category: TaxonomyItem };
const { site, taxonomy, projectsByCategory } = await getCatalogSnapshot();
const projects = projectsByCategory.get(category.id) ?? [];
const projectItems = toProjectCardViewModels(projects, taxonomy);
const { layout } = getActivePresentation();
---

<BaseLayout title={`${category.name} - GitHub Gallery`} site={site} description={category.description}>
  <PageHeader
    eyebrow="Category"
    title={category.name}
    description={category.description ?? "Projects grouped by category."}
    variant="filter"
    asideLabel="Category summary and actions"
    stats={[{ value: projects.length, label: "Projects" }]}
  >
    <Fragment slot="actions">
      <Button href="/" variant="outline">All projects</Button>
    </Fragment>
  </PageHeader>
  <ProjectCollection
    id={`category-${category.id}`}
    title={`${category.name} projects`}
    items={projectItems}
    emptyMessage="No projects in this category yet."
    variant={layout.listPages.projectCollectionVariant}
  />
</BaseLayout>
