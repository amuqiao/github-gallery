---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import { getCatalogSnapshot, type TaxonomyItem } from "@/lib/catalog/projects";

export async function getStaticPaths() {
  const { taxonomy } = await getCatalogSnapshot();
  return taxonomy.categories.map((category) => ({
    params: { category: category.id },
    props: { category }
  }));
}

const { category } = Astro.props as { category: TaxonomyItem };
const { taxonomy, projectsByCategory } = await getCatalogSnapshot();
const projects = projectsByCategory.get(category.id) ?? [];
---

<BaseLayout title={`${category.name} - GitHub Gallery`} description={category.description}>
  <PageHeader
    eyebrow="Category"
    title={category.name}
    description={category.description ?? "Projects grouped by category."}
    variant="filter"
    asideLabel="Category summary and actions"
    stats={[{ value: projects.length, label: "Projects" }]}
  >
    <Fragment slot="actions">
      <a class="button-link" href="/">All projects</a>
    </Fragment>
  </PageHeader>
  <ProjectCollection
    id={`category-${category.id}`}
    title={`${category.name} projects`}
    projects={projects}
    taxonomy={taxonomy}
    emptyMessage="No projects in this category yet."
  />
</BaseLayout>
