---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import Button from "@/components/ui/Button.astro";
import { getCatalogSnapshot, type LocalizedTaxonomyItem } from "@/lib/catalog/projects";
import { toProjectCardViewModels } from "@/lib/catalog/project-view-models";
import { getActivePresentation } from "@/presentation";

export async function getStaticPaths() {
  const { taxonomy } = await getCatalogSnapshot();
  return taxonomy.categories.map((category) => ({
    params: { category: category.id },
    props: { category }
  }));
}

const { category } = Astro.props as { category: LocalizedTaxonomyItem };
const { site, taxonomy, projectsByCategory } = await getCatalogSnapshot();
const projects = projectsByCategory.get(category.id) ?? [];
const projectItems = toProjectCardViewModels(projects, taxonomy);
const { layout } = getActivePresentation();
---

<BaseLayout title={`${category.label} - GitHub Gallery`} site={site} description={category.descriptionText}>
  <Breadcrumbs
    items={[
      { label: "展馆", href: "/" },
      { label: "分类", href: "/#categories" },
      { label: category.label }
    ]}
  />
  <PageHeader
    eyebrow="分类"
    title={category.label}
    description={category.descriptionText}
    variant="filter"
    asideLabel="分类统计和操作"
    stats={[{ value: projects.length, label: "项目" }]}
  >
    <Fragment slot="actions">
      <Button href="/" variant="outline">全部项目</Button>
    </Fragment>
  </PageHeader>
  <ProjectCollection
    id={`category-${category.id}`}
    title="项目"
    hint={`${projects.length} 个项目`}
    items={projectItems}
    emptyMessage="这个分类下暂无项目。"
    variant={layout.listPages.projectCollectionVariant}
  />
</BaseLayout>
