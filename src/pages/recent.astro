---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { getRecentPublishedEntries } from "@/lib/catalog/search";
import { getSiteConfig } from "@/lib/catalog/site";

const [site, entries] = await Promise.all([getSiteConfig(), getRecentPublishedEntries()]);

const formatDateLabel = (value: string) => {
  const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  if (!match) {
    return value;
  }

  return `${match[1]}年${Number(match[2])}月${Number(match[3])}日`;
};

const formatMonthLabel = (value: string) => {
  const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  if (!match) {
    return "DATE";
  }

  return `${match[1]}.${match[2]}`;
};

const typeLabel = (type: "item" | "note") => (type === "note" ? "笔记" : "条目");
const kindLabel = (kind: string) => kind.replaceAll("_", " ");
const recentGroups = entries.reduce<Array<{ date: string; entries: typeof entries }>>((groups, entry) => {
  const lastGroup = groups.at(-1);

  if (lastGroup?.date === entry.added_at) {
    lastGroup.entries.push(entry);
    return groups;
  }

  groups.push({ date: entry.added_at, entries: [entry] });
  return groups;
}, []);
---

<BaseLayout title="最近新增 - Gallery Platform" site={site} description="查看最近新增的已发布条目与笔记。">
  <article class="grid gap-6">
    <Breadcrumbs
      items={[
        { label: "展馆入口", href: "/" },
        { label: "最近新增" }
      ]}
    />
    <PageHeader
      eyebrow="Catalog / Recent"
      title="最近新增"
      description="按收录时间浏览新增内容，条目与笔记共用同一时间线。"
      stats={[
        { label: "新增", value: entries.length },
        { label: "类型", value: "条目 + 笔记" }
      ]}
    >
      <Fragment slot="actions">
        <Button href="/search/" variant="outline">搜索索引</Button>
        <Button href="/">返回首页</Button>
      </Fragment>
    </PageHeader>

    <section class="gallery-section" aria-labelledby="recent-list-title">
      <div class="editorial-section-head">
        <span class="editorial-section-head__index">01</span>
        <h2 class="editorial-section-head__title" id="recent-list-title">时间线</h2>
        <span class="editorial-section-head__hint">{entries.length} 条记录</span>
      </div>
      {
        entries.length > 0 ? (
          <div class="recent-timeline" aria-label="最近新增时间线">
            {recentGroups.map((group) => (
              <section class="recent-timeline__group" aria-labelledby={`recent-${group.date}`}>
                <div class="recent-timeline__date">
                  <time datetime={group.date} id={`recent-${group.date}`}>
                    <span class="recent-timeline__month">{formatMonthLabel(group.date)}</span>
                    <span class="recent-timeline__day">{formatDateLabel(group.date)}</span>
                  </time>
                  <span class="recent-timeline__count">{group.entries.length} 条</span>
                </div>
                <div class="recent-timeline__items">
                  {group.entries.map((entry) => (
                    <a
                      class="recent-card"
                      href={entry.route}
                      aria-label={`查看${typeLabel(entry.type)} ${entry.title}，${entry.hall} / ${kindLabel(entry.kind)}`}
                    >
                      <div class="recent-card__content">
                        <div class="recent-card__top">
                          <span class="recent-card__type">{typeLabel(entry.type)}</span>
                          <span class="recent-card__meta">{entry.hall} / {kindLabel(entry.kind)}</span>
                        </div>
                        <h3 class="recent-card__title">{entry.title}</h3>
                        {entry.parentTitle && <p class="recent-card__parent">关联 · {entry.parentTitle}</p>}
                        <p class="recent-card__summary">{entry.summary}</p>
                      </div>
                      {
                        entry.labels.length > 0 && (
                          <ul class="recent-card__labels" aria-label="内容标签">
                            {entry.labels.slice(0, 6).map((label) => <li><span class="recent-card__label">{label}</span></li>)}
                          </ul>
                        )
                      }
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <EmptyState message="当前没有最近新增的已发布内容。" />
        )
      }
    </section>
  </article>
</BaseLayout>
