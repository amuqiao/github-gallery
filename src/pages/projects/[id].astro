---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockRenderer from "@/components/blocks/BlockRenderer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProjectHero from "@/components/ProjectHero.astro";
import RelatedProjects from "@/components/RelatedProjects.astro";
import { loadProjectDetail } from "@/lib/catalog/details";
import {
  getAllProjects,
  getCatalogSnapshot,
  getCategory,
  getRelatedProjects,
  getTag,
  type Project
} from "@/lib/catalog/projects";

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props as { project: Project };
const { taxonomy } = await getCatalogSnapshot();
const category = getCategory(taxonomy, project.category);
const tags = project.tags.map((tag) => getTag(taxonomy, tag));
const relatedProjects = await getRelatedProjects(project);
const detail = await loadProjectDetail(project);
const DetailContent = detail?.Content;
---

<BaseLayout title={`${project.name} - GitHub Gallery`} description={project.summary}>
  <article class="project-detail">
    <Breadcrumbs
      items={[
        { label: "Projects", href: "/" },
        { label: category.name, href: `/categories/${category.id}/` },
        { label: project.name }
      ]}
    />
    <ProjectHero project={project} category={category} tags={tags} />

    {
      detail && (
        <section class="detail-body">
          {DetailContent && <DetailContent />}
        </section>
      )
    }
    {
      project.blocks.length > 0 && (
        <section class="block-stack" aria-label="Project details">
          {project.blocks.map((block, index) => <BlockRenderer block={block} index={index} />)}
        </section>
      )
    }
    <RelatedProjects projects={relatedProjects} taxonomy={taxonomy} />
  </article>
</BaseLayout>
