---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockRenderer from "@/components/blocks/BlockRenderer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CollectionGrid from "@/components/CollectionGrid.astro";
import ProjectHero from "@/components/ProjectHero.astro";
import ProjectNotes from "@/components/ProjectNotes.astro";
import RelatedProjects from "@/components/RelatedProjects.astro";
import Prose from "@/components/ui/Prose.astro";
import { getCollectionsForProject } from "@/lib/catalog/collections";
import { loadProjectDetail } from "@/lib/catalog/details";
import {
  getAllProjects,
  getCatalogSnapshot,
  getCategory,
  getProjectMaintenanceStatus,
  getRelatedProjects,
  getTag,
  type Project
} from "@/lib/catalog/projects";
import { toProjectCardViewModels } from "@/lib/catalog/project-view-models";
import { getActivePresentation } from "@/presentation";

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props as { project: Project };
const { site, taxonomy } = await getCatalogSnapshot();
const category = getCategory(taxonomy, project.category);
const tags = project.tags.map((tag) => getTag(taxonomy, tag));
const maintenanceStatus = getProjectMaintenanceStatus(taxonomy, project.maintenance_status);
const relatedProjects = await getRelatedProjects(project);
const relatedProjectItems = toProjectCardViewModels(relatedProjects, taxonomy);
const detail = await loadProjectDetail(project);
const DetailContent = detail?.Content;
const memberCollections = await getCollectionsForProject(project.id);
const { layout } = getActivePresentation();
---

<BaseLayout title={`${project.name} - GitHub Gallery`} site={site} description={project.summary}>
  <article class="grid gap-6">
    <Breadcrumbs
      items={[
        { label: "展馆", href: "/" },
        { label: category.label, href: `/categories/${category.id}/` },
        { label: project.name }
      ]}
    />
    <ProjectHero project={project} category={category} tags={tags} maintenanceStatus={maintenanceStatus} />
    <ProjectNotes notes={project.notes} />

    {
      detail && (
        <Prose>
          {DetailContent && <DetailContent />}
        </Prose>
      )
    }
    {
      project.blocks.length > 0 && (
        <section class="content-blocks" aria-label="项目详情">
          {project.blocks.map((block, index) => <BlockRenderer block={block} index={index} />)}
        </section>
      )
    }
    {
      memberCollections.length > 0 && (
        <CollectionGrid
          id="project-collections"
          title="出现在这些专题"
          hint={`${memberCollections.length} 个专题`}
          collections={memberCollections}
          variant={layout.detailPages.collectionGridVariant}
          cardHeadingLevel={3}
        />
      )
    }
    <RelatedProjects items={relatedProjectItems} />
  </article>
</BaseLayout>
