---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Prose from "@/components/ui/Prose.astro";
import { loadProjectNote } from "@/lib/catalog/details";
import { getAllProjects, getCatalogSnapshot, getCategory, type Project, type ProjectNote } from "@/lib/catalog/projects";

export async function getStaticPaths() {
  const projects = await getAllProjects();

  return projects.flatMap((project) =>
    project.notes.map((note) => ({
      params: { id: project.id, note: note.id },
      props: { project, note }
    }))
  );
}

const { project, note } = Astro.props as { project: Project; note: ProjectNote };
const { site, taxonomy } = await getCatalogSnapshot();
const category = getCategory(taxonomy, project.category);
const noteDetail = await loadProjectNote(project, note);

if (note.display === "standalone") {
  if (noteDetail.type !== "html" || note.html_mode !== "document") {
    throw new Error(`${project.id} note ${note.id} uses standalone display without html document content`);
  }

  return new Response(noteDetail.html, {
    headers: {
      "Content-Type": "text/html; charset=utf-8"
    }
  });
} else if (noteDetail.type === "html" && note.html_mode !== "fragment") {
  throw new Error(`${project.id} note ${note.id} uses site display without html fragment content`);
}

const MarkdownContent = noteDetail.type === "markdown" ? noteDetail.Content : undefined;
const htmlFragment = noteDetail.type === "html" ? noteDetail.html : undefined;
const formatLabel = noteDetail.type === "markdown" ? "Markdown" : "HTML 片段";
---

<BaseLayout title={`${note.title} - ${project.name} - GitHub 展馆`} site={site} description={note.summary}>
  <article class="grid gap-6">
    <Breadcrumbs
      items={[
        { label: "GitHub 展馆", href: "/halls/github/" },
        { label: category.label, href: `/categories/${category.id}/` },
        { label: project.name, href: project.route },
        { label: note.title }
      ]}
    />
    <PageHeader
      eyebrow={`${project.name} / 项目笔记`}
      title={note.title}
      description={note.summary}
      stats={[
        { label: "格式", value: formatLabel },
        { label: "展示", value: "站内文章" }
      ]}
    >
      <Fragment slot="actions">
        <Button href={project.route} variant="outline">返回项目</Button>
      </Fragment>
    </PageHeader>
    <Prose>
      {MarkdownContent && <MarkdownContent />}
      {htmlFragment && <Fragment set:html={htmlFragment} />}
    </Prose>
  </article>
</BaseLayout>
