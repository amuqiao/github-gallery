---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentItemCard from "@/components/ContentItemCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { getPublishedContentItemsByHallAndKind } from "@/lib/catalog/content";
import { getHallById } from "@/lib/catalog/halls";
import { getSiteConfig } from "@/lib/catalog/projects";

const [site, hall, items] = await Promise.all([
  getSiteConfig(),
  getHallById("models"),
  getPublishedContentItemsByHallAndKind("models", "ai_model")
]);
---

<BaseLayout title={`${hall.title} - Gallery Platform`} site={site} description={hall.summary}>
  <article class="grid gap-6">
    <Breadcrumbs
      items={[
        { label: "展馆入口", href: "/" },
        { label: hall.title }
      ]}
    />
    <PageHeader
      eyebrow="Hall / Models"
      title={hall.title}
      description={hall.summary}
      stats={[
        { label: "模型", value: items.length },
        { label: "状态", value: "已开放" }
      ]}
    >
      <Fragment slot="actions">
        <Button href="/" variant="outline">返回入口</Button>
      </Fragment>
    </PageHeader>

    <section class="gallery-section" aria-labelledby="models-title">
      <div class="editorial-section-head">
        <span class="editorial-section-head__index">01</span>
        <h2 class="editorial-section-head__title" id="models-title">模型目录</h2>
        <span class="editorial-section-head__hint">{items.length} 个模型</span>
      </div>
      {
        items.length > 0 ? (
          <div class="project-collection__grid project-collection__grid--standard">
            {items.map((item) => <ContentItemCard item={item} />)}
          </div>
        ) : (
          <EmptyState message="当前没有已发布模型。" />
        )
      }
    </section>
  </article>
</BaseLayout>
