---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Prose from "@/components/ui/Prose.astro";
import { getPublishedContentItems, type ContentItem, type ContentNote } from "@/lib/catalog/content";
import { loadContentNote } from "@/lib/catalog/details";
import { getHallById } from "@/lib/catalog/halls";
import { getSiteConfig } from "@/lib/catalog/projects";

export async function getStaticPaths() {
  const items = await getPublishedContentItems();
  return items.flatMap((item) =>
    item.notes.map((note) => ({
      params: { hall: item.hall, id: item.id, note: note.id },
      props: { item, note }
    }))
  );
}

const { item, note } = Astro.props as { item: ContentItem; note: ContentNote };
const [site, hall, noteDetail] = await Promise.all([
  getSiteConfig(),
  getHallById(item.hall),
  loadContentNote(item, note)
]);

if (note.display === "standalone") {
  if (noteDetail.type !== "html" || note.html_mode !== "document") {
    throw new Error(`${item.hall}/${item.id} note ${note.id} uses standalone display without html document content`);
  }

  return new Response(noteDetail.html, {
    headers: {
      "Content-Type": "text/html; charset=utf-8"
    }
  });
} else if (noteDetail.type === "html" && note.html_mode !== "fragment") {
  throw new Error(`${item.hall}/${item.id} note ${note.id} uses site display without html fragment content`);
}

const MarkdownContent = noteDetail.type === "markdown" ? noteDetail.Content : undefined;
const htmlFragment = noteDetail.type === "html" ? noteDetail.html : undefined;
const formatLabel = noteDetail.type === "markdown" ? "Markdown" : "HTML 片段";
---

<BaseLayout title={`${note.title} - ${item.title} - ${hall.title}`} site={site} description={note.summary}>
  <article class="grid gap-6">
    <Breadcrumbs
      items={[
        { label: "展馆入口", href: "/" },
        { label: hall.title, href: `/halls/${item.hall}/` },
        { label: item.title, href: item.route },
        { label: note.title }
      ]}
    />
    <PageHeader
      eyebrow={`${item.title} / 笔记`}
      title={note.title}
      description={note.summary}
      stats={[
        { label: "格式", value: formatLabel },
        { label: "展示", value: "站内文章" }
      ]}
    >
      <Fragment slot="actions">
        <Button href={item.route} variant="outline">返回条目</Button>
      </Fragment>
    </PageHeader>
    <Prose>
      {MarkdownContent && <MarkdownContent />}
      {htmlFragment && <Fragment set:html={htmlFragment} />}
    </Prose>
  </article>
</BaseLayout>
