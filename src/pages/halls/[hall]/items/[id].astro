---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockRenderer from "@/components/blocks/BlockRenderer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentCollectionCard from "@/components/ContentCollectionCard.astro";
import ContentItemCard from "@/components/ContentItemCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Prose from "@/components/ui/Prose.astro";
import {
  getPublishedContentCollectionsForItem,
  getPublishedContentItems,
  getRelatedPublishedContentItems,
  type ContentItem
} from "@/lib/catalog/content";
import { loadContentItemBody } from "@/lib/catalog/details";
import { getHallById } from "@/lib/catalog/halls";
import { getCategory, getProjectMaintenanceStatus, getSiteConfig, getTag, getTaxonomyCatalog } from "@/lib/catalog/projects";

export async function getStaticPaths() {
  const items = await getPublishedContentItems();
  return items.map((item) => ({
    params: { hall: item.hall, id: item.id },
    props: { item }
  }));
}

const { item } = Astro.props as { item: ContentItem };
const [site, hall, body, memberCollections, relatedItems] = await Promise.all([
  getSiteConfig(),
  getHallById(item.hall),
  loadContentItemBody(item),
  getPublishedContentCollectionsForItem(item.hall, item.id),
  getRelatedPublishedContentItems(item)
]);
const BodyContent = body.type === "markdown" ? body.Content : undefined;
const htmlFragment = body.type === "html" ? body.html : undefined;
const profile = item.profile;
const isAiModel = "provider" in profile;
const taxonomy = isAiModel ? undefined : await getTaxonomyCatalog();
const category = !isAiModel && taxonomy ? getCategory(taxonomy, profile.category) : undefined;
const tags = !isAiModel && taxonomy ? profile.tags.map((tag) => getTag(taxonomy, tag)) : [];
const maintenanceStatus =
  !isAiModel && taxonomy ? getProjectMaintenanceStatus(taxonomy, profile.maintenance_status) : undefined;
const stats =
  isAiModel
    ? [
        { label: "提供方", value: profile.provider },
        { label: "模态", value: `${profile.modalities.input.join("+")} -> ${profile.modalities.output.join("+")}` },
        { label: "格式", value: profile.formats.join(" · ") }
      ]
    : [
        { label: "分类", value: category?.label ?? profile.category },
        { label: "维护", value: maintenanceStatus?.label ?? profile.maintenance_status },
        { label: "语言", value: profile.languages?.[0] ?? "Unknown" },
        { label: "License", value: profile.license ?? "Unknown" }
      ];
const badges = isAiModel ? profile.tasks : tags.map((tag) => tag.label);
let sectionNumber = 1;
const notesSectionIndex = item.notes.length > 0 ? String(sectionNumber++).padStart(2, "0") : undefined;
const memberCollectionsSectionIndex =
  memberCollections.length > 0 ? String(sectionNumber++).padStart(2, "0") : undefined;
const relatedItemsSectionIndex = relatedItems.length > 0 ? String(sectionNumber++).padStart(2, "0") : undefined;
---

<BaseLayout title={`${item.title} - ${hall.title}`} site={site} description={item.summary}>
  <article class="grid gap-6">
    <Breadcrumbs
      items={[
        { label: "展馆入口", href: "/" },
        { label: hall.title, href: `/halls/${item.hall}/` },
        { label: item.title }
      ]}
    />
    <PageHeader
      eyebrow={`${hall.title} / ${item.kind === "ai_model" ? "模型" : "项目"}`}
      title={item.title}
      description={item.summary}
      stats={stats}
    >
      <Fragment slot="meta">
        {badges.map((badge) => <Badge>{badge}</Badge>)}
      </Fragment>
      <Fragment slot="actions">
        <Button href={item.source.url}>打开来源</Button>
        <Button href={`/halls/${item.hall}/`} variant="outline">返回展馆</Button>
      </Fragment>
    </PageHeader>

    {
      item.notes.length > 0 && (
        <section class="gallery-section" aria-labelledby="content-notes-title">
          <div class="editorial-section-head">
            <span class="editorial-section-head__index">{notesSectionIndex}</span>
            <h2 class="editorial-section-head__title" id="content-notes-title">附加笔记</h2>
            <span class="editorial-section-head__hint">{item.notes.length} 篇</span>
          </div>
          <div class="model-note-grid">
            {item.notes.map((note) => (
              <a class="model-note-card" href={note.route}>
                <span>{note.type === "markdown" ? "Markdown" : "HTML"}</span>
                <strong>{note.title}</strong>
                <p>{note.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      memberCollections.length > 0 && (
        <section class="gallery-section" aria-labelledby="content-collections-title">
          <div class="editorial-section-head">
            <span class="editorial-section-head__index">{memberCollectionsSectionIndex}</span>
            <h2 class="editorial-section-head__title" id="content-collections-title">出现在这些专题</h2>
            <span class="editorial-section-head__hint">{memberCollections.length} 个专题</span>
          </div>
          <div class="collection-grid__grid collection-grid__grid--standard">
            {memberCollections.map((collection) => <ContentCollectionCard collection={collection} />)}
          </div>
        </section>
      )
    }

    <Prose>
      {BodyContent && <BodyContent />}
      {htmlFragment && <Fragment set:html={htmlFragment} />}
    </Prose>

    {
      item.blocks.length > 0 && (
        <section class="content-blocks" aria-label="条目详情">
          {item.blocks.map((block, index) => <BlockRenderer block={block} index={index} />)}
        </section>
      )
    }

    {
      relatedItems.length > 0 && (
        <section class="gallery-section" aria-labelledby="related-content-title">
          <div class="editorial-section-head">
            <span class="editorial-section-head__index">{relatedItemsSectionIndex}</span>
            <h2 class="editorial-section-head__title" id="related-content-title">相关项目</h2>
            <span class="editorial-section-head__hint">{relatedItems.length} 个项目</span>
          </div>
          <div class="project-collection__grid project-collection__grid--compact">
            {relatedItems.map((relatedItem) => <ContentItemCard item={relatedItem} />)}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
