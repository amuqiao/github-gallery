---
import "@/styles/global.css";
import { getActivePresentation } from "@/presentation";

interface Props {
  title: string;
  site: {
    title: string;
    description: string;
    navigation: Array<{
      label: string;
      href: string;
    }>;
  };
  description?: string;
}

const { title, site, description = site.description } = Astro.props;
const { layout, theme } = getActivePresentation();
const normalizePath = (href: string) => (href === "/" ? "/" : href.endsWith("/") ? href : `${href}/`);
const currentPath = normalizePath(Astro.url.pathname);
---

<!doctype html>
<html lang="zh-CN" data-layout={layout.id} data-theme={theme.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主内容</a>
    <div class="site-shell">
      <header class="site-topbar">
        <nav class="site-nav" aria-label="Primary">
          <a class="site-brand" href="/">
            <span class="site-brand__mark" aria-hidden="true"></span>
            {site.title}
          </a>
          <div class="site-nav__links">
            {
              site.navigation.map((item) => {
                const isActive = currentPath === normalizePath(item.href);
                return <a href={item.href} aria-current={isActive ? "page" : undefined}>{item.label}</a>;
              })
            }
          </div>
        </nav>
      </header>
      <main class="site-main" id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <span>Contract-driven GitHub project gallery.</span>
        <span>{layout.label} / {theme.label}</span>
      </footer>
    </div>
  </body>
</html>
