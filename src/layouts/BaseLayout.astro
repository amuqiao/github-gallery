---
import { getCatalogSnapshot } from "@/lib/catalog/projects";

interface Props {
  title: string;
  description?: string;
}

const { site } = await getCatalogSnapshot();
const { title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f8fafc;
        --surface: #ffffff;
        --surface-muted: #eef2f7;
        --text: #18202f;
        --muted: #637083;
        --line: #d9e0ea;
        --accent: #0f766e;
        --accent-strong: #0b5f59;
        --focus: #b45309;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--accent-strong);
      }

      .site-shell {
        min-height: 100vh;
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--surface) 92%, transparent);
      }

      .site-nav,
      main,
      .site-footer {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
      }

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-height: 68px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 750;
        letter-spacing: 0;
      }

      .brand-mark {
        display: grid;
        width: 28px;
        height: 28px;
        grid-template-columns: repeat(2, 1fr);
        gap: 3px;
      }

      .brand-mark span {
        border-radius: 4px;
        background: var(--accent);
      }

      .brand-mark span:nth-child(2) {
        background: #2563eb;
      }

      .brand-mark span:nth-child(3) {
        background: #b45309;
      }

      .brand-mark span:nth-child(4) {
        background: #475569;
      }

      .site-nav__links {
        display: flex;
        gap: 16px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      main {
        padding: 44px 0 64px;
      }

      .hero {
        display: grid;
        gap: 18px;
        padding: 24px 0 36px;
      }

      .eyebrow {
        margin: 0;
        color: var(--accent-strong);
        font-size: 0.86rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 800px;
        margin-bottom: 0;
        font-size: clamp(2.1rem, 6vw, 4.8rem);
        line-height: 1.02;
        letter-spacing: 0;
      }

      h2 {
        line-height: 1.18;
        letter-spacing: 0;
      }

      .lead {
        max-width: 760px;
        margin: 0;
        color: var(--muted);
        font-size: 1.08rem;
      }

      .stats {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 12px;
      }

      .stat {
        display: inline-flex;
        flex-direction: column;
        min-width: 132px;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 12px 14px;
        background: var(--surface);
      }

      .stat strong {
        font-size: 1.35rem;
        line-height: 1.1;
      }

      .stat span {
        color: var(--muted);
        font-size: 0.86rem;
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 18px;
        margin: 36px 0 18px;
      }

      .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
        gap: 16px;
      }

      .project-card {
        display: flex;
        min-height: 280px;
        flex-direction: column;
        gap: 13px;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 18px;
        background: var(--surface);
      }

      .project-card__meta,
      .project-detail__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        color: var(--muted);
        font-size: 0.84rem;
      }

      .project-card__category,
      .project-card__tags a,
      .project-detail__tags a {
        border-radius: 999px;
        padding: 3px 9px;
        background: var(--surface-muted);
        color: var(--text);
        text-decoration: none;
      }

      .project-card h2 {
        margin: 0;
        font-size: 1.16rem;
      }

      .project-card p {
        margin: 0;
        color: var(--muted);
      }

      .project-card__tags,
      .project-detail__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
      }

      .project-card__repo {
        margin-top: auto;
        color: var(--accent-strong);
        font-weight: 700;
      }

      .taxonomy-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 0;
        list-style: none;
      }

      .taxonomy-list a {
        display: inline-flex;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 8px 12px;
        background: var(--surface);
        text-decoration: none;
      }

      .project-detail {
        display: grid;
        gap: 22px;
      }

      .detail-body {
        max-width: 820px;
        border-top: 1px solid var(--line);
        padding-top: 28px;
      }

      .detail-body img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
      }

      .site-footer {
        border-top: 1px solid var(--line);
        padding: 24px 0 36px;
        color: var(--muted);
        font-size: 0.92rem;
      }

      @media (max-width: 680px) {
        .site-nav {
          align-items: flex-start;
          flex-direction: column;
          justify-content: center;
          padding: 14px 0;
        }

        main {
          padding-top: 28px;
        }
      }
    </style>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="site-nav" aria-label="Primary">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </span>
            {site.title}
          </a>
          <div class="site-nav__links">
            {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">Contract-driven GitHub project gallery.</footer>
    </div>
  </body>
</html>
