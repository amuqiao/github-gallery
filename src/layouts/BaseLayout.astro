---
import "@/styles/global.css";
import { getActivePresentation } from "@/presentation";

interface Props {
  title: string;
  site: {
    title: string;
    description: string;
    navigation: Array<{
      label: string;
      href: string;
    }>;
  };
  description?: string;
}

const { title, site, description = site.description } = Astro.props;
const { layout, theme } = getActivePresentation();
const normalizePath = (href: string) => (href === "/" ? "/" : href.endsWith("/") ? href : `${href}/`);
const currentPath = normalizePath(Astro.url.pathname);
const currentSection = currentPath.startsWith("/collections/")
  ? "collections"
  : currentPath.startsWith("/categories/") || currentPath.startsWith("/tags/")
    ? "categories"
    : "projects";
const navigationSection = (href: string) =>
  href.startsWith("/collections") ? "collections" : href.includes("#categories") ? "categories" : "projects";
const navigationLabel = (label: string) =>
  ({
    Projects: "项目",
    Collections: "专题",
    Categories: "分类"
  })[label] ?? label;
---

<!doctype html>
<html lang="zh-CN" data-layout={layout.id} data-theme={theme.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主内容</a>
    <div class="site-shell">
      <header class="site-topbar">
        <nav class="site-nav" aria-label="主导航">
          <a class="site-brand" href="/">
            <span class="site-brand__mark" aria-hidden="true"></span>
            {site.title}
          </a>
          <span class="site-path" aria-hidden="true">~/ $</span>
          <div class="site-nav__links">
            {
              site.navigation.map((item) => {
                const isActive = navigationSection(item.href) === currentSection;
                return <a href={item.href} aria-current={isActive ? "page" : undefined}>{navigationLabel(item.label)}</a>;
              })
            }
          </div>
        </nav>
      </header>
      <main class="site-main" id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <span>GitHub Gallery — 合同驱动的开源项目静态展馆</span>
        <span>方案 B · Bento 杂志编辑 · 纸面主题</span>
      </footer>
    </div>
  </body>
</html>
