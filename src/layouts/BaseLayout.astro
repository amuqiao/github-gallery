---
import "@/styles/global.css";

interface Props {
  title: string;
  site: {
    title: string;
    description: string;
    navigation: Array<{
      label: string;
      href: string;
    }>;
  };
  description?: string;
}

const { title, site, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen">
      <header class="border-b bg-card/90">
        <nav class="mx-auto flex min-h-16 w-full max-w-6xl flex-col items-start justify-center gap-3 px-4 py-3 md:flex-row md:items-center md:justify-between md:gap-6 md:py-0" aria-label="Primary">
          <a class="inline-flex items-center gap-2.5 font-bold no-underline" href="/">
            <span class="grid size-7 grid-cols-2 gap-0.5" aria-hidden="true">
              <span class="rounded-sm bg-primary"></span>
              <span class="rounded-sm bg-blue-600"></span>
              <span class="rounded-sm bg-amber-700"></span>
              <span class="rounded-sm bg-slate-600"></span>
            </span>
            {site.title}
          </a>
          <div class="flex flex-wrap gap-4 text-sm text-muted-foreground">
            {site.navigation.map((item) => <a class="no-underline hover:text-primary" href={item.href}>{item.label}</a>)}
          </div>
        </nav>
      </header>
      <main class="mx-auto w-full max-w-6xl px-4 py-9 md:py-11">
        <slot />
      </main>
      <footer class="mx-auto w-full max-w-6xl border-t px-4 py-6 text-sm text-muted-foreground">
        Contract-driven GitHub project gallery.
      </footer>
    </div>
  </body>
</html>
