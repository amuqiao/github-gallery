---
interface SearchEntry {
  id: string;
  type: "item" | "note";
  hall: string;
  kind: string;
  title: string;
  summary: string;
  route: string;
  added_at: string;
  parentTitle?: string;
  labels: string[];
  searchText: string;
}

interface Props {
  entry: SearchEntry;
}

const { entry } = Astro.props;

const formatAddedAt = (value: string) => {
  const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  if (!match) {
    return value;
  }

  return `${match[1]}年${Number(match[2])}月${Number(match[3])}日`;
};

const typeLabel = entry.type === "note" ? "笔记" : "条目";
const kindLabel = entry.kind.replaceAll("_", " ");
---

<a class="search-entry-card" href={entry.route} aria-label={`查看${typeLabel} ${entry.title}`}>
  <div class="search-entry-card__top">
    <span class="search-entry-card__type">{typeLabel}</span>
    <time class="search-entry-card__date" datetime={entry.added_at}>{formatAddedAt(entry.added_at)}</time>
  </div>
  <div class="search-entry-card__body">
    <h3 class="search-entry-card__title">{entry.title}</h3>
    <p class="search-entry-card__id">{entry.id}</p>
    {entry.parentTitle && <p class="search-entry-card__parent">关联条目 · {entry.parentTitle}</p>}
    <p class="search-entry-card__summary">{entry.summary}</p>
  </div>
  {
    entry.labels.length > 0 && (
      <ul class="search-entry-card__labels" aria-label="搜索标签">
        {entry.labels.slice(0, 5).map((label) => <li><span class="search-entry-card__label">{label}</span></li>)}
      </ul>
    )
  }
  <div class="search-entry-card__footer">
    <span class="search-entry-card__meta">{entry.hall} / {kindLabel}</span>
    <span class="search-entry-card__action">打开 →</span>
  </div>
</a>
