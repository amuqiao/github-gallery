---
import CollectionCard from "@/components/CollectionCard.astro";
import Badge from "@/components/ui/Badge.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { Collection } from "@/lib/catalog/collections";
import type { CollectionGridVariant } from "@/presentation/types";

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  collections: Collection[];
  emptyMessage?: string;
  cardHeadingLevel?: 2 | 3;
  variant?: CollectionGridVariant;
}

const {
  id = "collections",
  eyebrow,
  title,
  description,
  collections,
  emptyMessage = "No collections yet.",
  cardHeadingLevel = 3,
  variant = "standard"
} = Astro.props;
const headingId = `${id}-heading`;
const gridClass = ["collection-grid__grid", `collection-grid__grid--${variant}`].join(" ");
---

<section class="gallery-section collection-grid" id={id} aria-labelledby={headingId}>
  <div class="gallery-section__head">
    <SectionHeader id={headingId} eyebrow={eyebrow} title={title} description={description} />
    <Badge variant="outline">{collections.length} collections</Badge>
  </div>
  {
    collections.length > 0 ? (
      <div class={gridClass}>
        {
          collections.map((collection) => (
            <CollectionCard collection={collection} headingLevel={cardHeadingLevel} variant={variant} />
          ))
        }
      </div>
    ) : (
      <EmptyState message={emptyMessage} />
    )
  }
</section>
