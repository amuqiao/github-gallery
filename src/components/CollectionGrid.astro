---
import CollectionCard from "@/components/CollectionCard.astro";
import EditorialSectionHeader from "@/components/EditorialSectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import type { Collection } from "@/lib/catalog/collections";
import type { CollectionGridVariant } from "@/presentation/types";

interface Props {
  id?: string;
  index?: string;
  title: string;
  description?: string;
  hint?: string;
  collections: Collection[];
  emptyMessage?: string;
  cardHeadingLevel?: 2 | 3;
  variant?: CollectionGridVariant;
}

const {
  id = "collections",
  index,
  title,
  description,
  hint,
  collections,
  emptyMessage = "暂无专题。",
  cardHeadingLevel = 3,
  variant = "standard"
} = Astro.props;
const headingId = `${id}-heading`;
const gridClass = ["collection-grid__grid", `collection-grid__grid--${variant}`].join(" ");
---

<section class="gallery-section collection-grid" id={id} aria-labelledby={headingId}>
  <EditorialSectionHeader id={headingId} index={index} title={title} hint={hint ?? `${collections.length} 个专题`} />
  {description && <p class="gallery-section__description">{description}</p>}
  {
    collections.length > 0 ? (
      <div class={gridClass}>
        {
          collections.map((collection) => (
            <CollectionCard collection={collection} headingLevel={cardHeadingLevel} variant={variant} />
          ))
        }
      </div>
    ) : (
      <EmptyState message={emptyMessage} />
    )
  }
</section>
