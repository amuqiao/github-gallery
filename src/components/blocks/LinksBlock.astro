---
import type { AdaptedProjectBlock } from "@/lib/catalog/block-adapters";
import ContentBlock from "@/components/ui/ContentBlock.astro";

type LinksBlock = Extract<AdaptedProjectBlock, { type: "links" }>;

interface Props {
  block: LinksBlock;
  headingId: string;
}

const { block, headingId } = Astro.props;
---

<ContentBlock headingId={headingId} title={block.title}>
  <ul class="m-0 list-disc pl-5 text-muted-foreground">
    {block.items.map((item) => <li><a class="font-semibold text-primary" href={item.url}>{item.label}</a></li>)}
  </ul>
</ContentBlock>
