---
import type { AdaptedProjectBlock } from "@/lib/catalog/block-adapters";

type ListBlock = Extract<AdaptedProjectBlock, { type: "highlights" | "use-cases" }>;

interface Props {
  block: ListBlock;
  headingId: string;
}

const { block, headingId } = Astro.props;
---

<section class="content-block" aria-labelledby={headingId}>
  <h2 id={headingId}>{block.title}</h2>
  <ul class="block-list">
    {block.items.map((item) => <li>{item}</li>)}
  </ul>
</section>
