---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
  <ol class="m-0 flex list-none flex-wrap gap-2 p-0">
    {
      items.map((item, index) => (
        <li class:list={[index < items.length - 1 && "after:ml-2 after:text-border after:content-['/']"]}>
          {item.href && index < items.length - 1 ? (
            <a class="no-underline hover:text-primary" href={item.href}>{item.label}</a>
          ) : (
            <span aria-current={index === items.length - 1 ? "page" : undefined}>{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
