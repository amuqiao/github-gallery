---
interface Source {
  type: string;
  url: string;
}

interface Props {
  source: Source;
}

const { source } = Astro.props;

const sourceLabels: Record<string, string> = {
  github: "GitHub",
  huggingface: "Hugging Face",
  website: "Website",
  docs: "Docs",
  paper: "Paper"
};

const sourceUrl = new URL(source.url);
const visibleUrl = `${sourceUrl.host}${sourceUrl.pathname}${sourceUrl.search}${sourceUrl.hash}`.replace(/\/$/, "");
const sourceLabel = sourceLabels[source.type] ?? source.type;
---

<div class="source-link-row">
  <span class="source-link-row__type">{sourceLabel}</span>
  <a class="source-link-row__url" href={source.url} target="_blank" rel="noopener noreferrer">
    {visibleUrl}
  </a>
  <button
    class="source-link-row__copy"
    type="button"
    aria-label="复制来源链接"
    title="复制来源链接"
    data-source-copy
    data-copy-value={source.url}
  >
    <svg class="source-link-row__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="9" y="9" width="10" height="10" rx="2"></rect>
      <path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
    </svg>
    <svg class="source-link-row__check-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m5 12 4 4 10-10"></path>
    </svg>
  </button>
</div>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-source-copy]");

  for (const button of copyButtons) {
    button.addEventListener("click", async () => {
      const value = button.dataset.copyValue;
      if (!value) {
        throw new Error("source copy button is missing data-copy-value");
      }

      await navigator.clipboard.writeText(value);
      button.classList.add("is-copied");
      button.setAttribute("aria-label", "已复制来源链接");
      window.setTimeout(() => {
        button.classList.remove("is-copied");
        button.setAttribute("aria-label", "复制来源链接");
      }, 1200);
    });
  }
</script>
