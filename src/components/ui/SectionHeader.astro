---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  titleLevel?: 1 | 2 | 3;
  class?: string;
}

const { eyebrow, title, description, id, titleLevel = 2, class: className } = Astro.props;
---

<div class:list={["space-y-2", className]}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-normal text-primary">{eyebrow}</p>}
  {
    titleLevel === 1 ? (
      <h1 id={id} class="max-w-4xl text-4xl font-bold leading-tight md:text-6xl">{title}</h1>
    ) : titleLevel === 3 ? (
      <h3 id={id} class="text-lg font-semibold leading-tight">{title}</h3>
    ) : (
      <h2 id={id} class="text-2xl font-semibold leading-tight md:text-3xl">{title}</h2>
    )
  }
  {description && <p class="max-w-3xl text-base text-muted-foreground md:text-lg">{description}</p>}
</div>
