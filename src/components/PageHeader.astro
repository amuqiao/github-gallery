---
interface Stat {
  label: string;
  value: string | number;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  variant?: "gallery" | "filter" | "project";
  stats?: Stat[];
  statsLabel?: string;
  asideLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  variant = "filter",
  stats = [],
  statsLabel = "页面统计",
  asideLabel = "页面操作"
} = Astro.props;
---

<section class:list={["page-header", `page-header--${variant}`]}>
  <div class="page-header__main">
    <div class="page-header__kicker">{eyebrow}</div>
    <h1 class="page-header__title">{title}</h1>
    {description && <p class="page-header__description">{description}</p>}
    {Astro.slots.has("meta") && <div class="page-header__meta"><slot name="meta" /></div>}
    {Astro.slots.has("footer") && <div class="page-header__footer"><slot name="footer" /></div>}
  </div>
  {
    (stats.length > 0 || Astro.slots.has("actions")) && (
      <aside class="page-header__aside" aria-label={asideLabel}>
        {stats.length > 0 && (
          <div class="page-header__stats" aria-label={statsLabel}>
            {stats.map((stat) => (
              <div class="page-header__stat">
                <b>{stat.value}</b>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
        )}
        {Astro.slots.has("actions") && <div class="page-header__actions"><slot name="actions" /></div>}
      </aside>
    )
  }
</section>
