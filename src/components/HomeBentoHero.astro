---
import type { Collection } from "@/lib/catalog/collections";

interface Props {
  featuredCollection: Collection;
  projectCount: number;
  collectionCount: number;
  tagCount: number;
}

const { featuredCollection, projectCount, collectionCount, tagCount } = Astro.props;
---

<header class="home-bento" aria-labelledby="home-title">
  <div class="home-bento__kicker">精选 GitHub 项目 — 第 01 期</div>
  <div class="home-bento__intro">
    <h1 id="home-title">开源声音技术的<br /><em>编年展馆</em></h1>
    <div class="home-bento__dek">
      <p>一个合同驱动的静态展馆。项目轴可按分类与标签过滤，专题轴由人工策展。同一套 read model 贯穿全站。</p>
      <p class="home-bento__issue">第 01 期<br />2026 · 静态构建<br />合同 v1</p>
    </div>
  </div>
  <ul class="home-bento__grid" aria-label="展馆概览">
    <li class="home-bento__item home-bento__item--feature">
      <a class="home-bento__cell home-bento__cell--feature" href={featuredCollection.route}>
        <span class="home-bento__bg" aria-hidden="true">✦</span>
        <span class="home-bento__label">精选专题</span>
        <strong>{featuredCollection.title}</strong>
        <span>{featuredCollection.summary}</span>
        <span class="home-bento__action">进入专题</span>
      </a>
    </li>
    <li class="home-bento__item">
      <div class="home-bento__cell">
        <span class="home-bento__label">项目</span>
        <strong>{projectCount}</strong>
      </div>
    </li>
    <li class="home-bento__item">
      <a class="home-bento__cell home-bento__cell--accent" href="/collections/">
        <span class="home-bento__label">专题</span>
        <strong>{collectionCount}</strong>
      </a>
    </li>
    <li class="home-bento__item">
      <div class="home-bento__cell">
        <span class="home-bento__label">活跃标签</span>
        <strong>{tagCount}</strong>
      </div>
    </li>
    <li class="home-bento__item">
      <div class="home-bento__cell">
        <span class="home-bento__label">合同</span>
        <strong class="home-bento__schema">v1</strong>
      </div>
    </li>
  </ul>
  <div class="home-bento__actions">
    <a class="editorial-button editorial-button--dark" href="#projects">浏览项目</a>
    <a class="editorial-button" href="#collections">浏览专题</a>
    <a class="editorial-button editorial-button--outline" href="#categories">浏览筛选</a>
  </div>
</header>
