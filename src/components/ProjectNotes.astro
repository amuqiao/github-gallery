---
import EditorialSectionHeader from "@/components/EditorialSectionHeader.astro";
import type { ProjectNote } from "@/lib/catalog/projects";

interface Props {
  notes: ProjectNote[];
}

const { notes } = Astro.props;

const displayLabels = {
  site: "站内文章",
  standalone: "独立页面"
} satisfies Record<ProjectNote["display"], string>;

function getTypeLabel(note: ProjectNote): string {
  if (note.type === "markdown") {
    return "Markdown";
  }

  return note.html_mode === "fragment" ? "HTML 片段" : "HTML";
}
---

{
  notes.length > 0 && (
    <section class="project-notes" aria-labelledby="project-notes-heading">
      <EditorialSectionHeader
        id="project-notes-heading"
        index="01"
        title="项目笔记"
        hint={`${notes.length} 篇内容`}
      />
      <div class="project-notes__grid">
        {notes.map((note, index) => (
          <a
            class="project-note-card"
            href={note.route}
            target={note.display === "standalone" ? "_blank" : undefined}
            rel={note.display === "standalone" ? "noopener noreferrer" : undefined}
            aria-label={`阅读 ${note.title}`}
          >
            <div class="project-note-card__top">
              <span class="project-note-card__order">{String(index + 1).padStart(2, "0")}</span>
              <span class="project-note-card__format">{getTypeLabel(note)} / {displayLabels[note.display]}</span>
            </div>
            <h2 class="project-note-card__title">{note.title}</h2>
            <p class="project-note-card__summary">{note.summary}</p>
            <span class="project-note-card__read">阅读笔记 →</span>
          </a>
        ))}
      </div>
    </section>
  )
}
