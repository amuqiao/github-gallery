---
import type { Project, TaxonomyItem } from "@/lib/catalog/projects";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import ChipLink from "@/components/ui/ChipLink.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { FilterPanelVariant } from "@/presentation/types";

interface Props {
  categories: TaxonomyItem[];
  tags: TaxonomyItem[];
  projects: Project[];
  variant?: FilterPanelVariant;
}

const { categories, tags, projects, variant = "standard" } = Astro.props;

const countByCategory = (categoryId: string) =>
  projects.filter((project) => project.category === categoryId).length;
const countByTag = (tagId: string) => projects.filter((project) => project.tags.includes(tagId)).length;
---

<section class:list={["gallery-section filter-panel", `filter-panel--${variant}`]} id="categories" aria-labelledby="browse-heading">
  <div class="gallery-section__head">
    <SectionHeader id="browse-heading" eyebrow="Browse" title="Browse by taxonomy" />
    <Button href="#projects" variant="ghost">All projects</Button>
  </div>
  <div class="filter-panel__grid">
    <Card as="section" class="filter-panel__card" ariaLabelledby="category-filter-heading">
      <h3 id="category-filter-heading" class="mb-3 text-lg font-semibold leading-tight">Categories</h3>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {
          categories.map((category) => (
            <li>
              <ChipLink href={`/categories/${category.id}/`} label={category.name} count={countByCategory(category.id)} />
            </li>
          ))
        }
      </ul>
    </Card>
    <Card as="section" class="filter-panel__card" ariaLabelledby="tag-filter-heading">
      <h3 id="tag-filter-heading" class="mb-3 text-lg font-semibold leading-tight">Tags</h3>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {
          tags.map((tag) => (
            <li>
              <ChipLink href={`/tags/${tag.id}/`} label={tag.name} count={countByTag(tag.id)} />
            </li>
          ))
        }
      </ul>
    </Card>
  </div>
</section>
