---
import type { Project, TaxonomyItem } from "@/lib/catalog/projects";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import ChipLink from "@/components/ui/ChipLink.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";

interface Props {
  categories: TaxonomyItem[];
  tags: TaxonomyItem[];
  projects: Project[];
}

const { categories, tags, projects } = Astro.props;

const countByCategory = (categoryId: string) =>
  projects.filter((project) => project.category === categoryId).length;
const countByTag = (tagId: string) => projects.filter((project) => project.tags.includes(tagId)).length;
---

<section class="pt-2" id="categories" aria-labelledby="browse-heading">
  <div class="mb-5 flex flex-col items-start justify-between gap-3 md:flex-row md:items-end">
    <SectionHeader id="browse-heading" eyebrow="Browse" title="Browse by taxonomy" />
    <Button href="#projects" variant="ghost">All projects</Button>
  </div>
  <div class="grid gap-5 border-b pb-7 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
    <Card as="section" class="p-4" ariaLabelledby="category-filter-heading">
      <h3 id="category-filter-heading" class="mb-3 text-lg font-semibold leading-tight">Categories</h3>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {
          categories.map((category) => (
            <li>
              <ChipLink href={`/categories/${category.id}/`} label={category.name} count={countByCategory(category.id)} />
            </li>
          ))
        }
      </ul>
    </Card>
    <Card as="section" class="p-4" ariaLabelledby="tag-filter-heading">
      <h3 id="tag-filter-heading" class="mb-3 text-lg font-semibold leading-tight">Tags</h3>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {
          tags.map((tag) => (
            <li>
              <ChipLink href={`/tags/${tag.id}/`} label={tag.name} count={countByTag(tag.id)} />
            </li>
          ))
        }
      </ul>
    </Card>
  </div>
</section>
