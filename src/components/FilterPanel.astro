---
import EditorialSectionHeader from "@/components/EditorialSectionHeader.astro";
import type { LocalizedTaxonomyItem, Project } from "@/lib/catalog/projects";
import ChipLink from "@/components/ui/ChipLink.astro";
import type { FilterPanelVariant } from "@/presentation/types";

interface Props {
  categories: LocalizedTaxonomyItem[];
  tags: LocalizedTaxonomyItem[];
  projects: Project[];
  index?: string;
  variant?: FilterPanelVariant;
}

const { categories, tags, projects, index, variant = "standard" } = Astro.props;

const countByCategory = (categoryId: string) =>
  projects.filter((project) => project.category === categoryId).length;
const countByTag = (tagId: string) => projects.filter((project) => project.tags.includes(tagId)).length;
---

<section class:list={["gallery-section filter-panel", `filter-panel--${variant}`]} id="categories" aria-labelledby="browse-heading">
  <EditorialSectionHeader id="browse-heading" index={index} title="浏览筛选" hint="进入过滤视图 →" />
  <div class="filter-panel__grid">
    <div class="filter-panel__label" id="category-filter-heading">分类</div>
    <div class="filter-panel__row" aria-labelledby="category-filter-heading">
      <ul class="filter-panel__chips">
        {
          categories.map((category) => (
            <li>
              <ChipLink href={`/categories/${category.id}/`} label={category.label} count={countByCategory(category.id)} />
            </li>
          ))
        }
      </ul>
    </div>
    <div class="filter-panel__label" id="tag-filter-heading">标签</div>
    <div class="filter-panel__row" aria-labelledby="tag-filter-heading">
      <ul class="filter-panel__chips">
        {
          tags.map((tag) => (
            <li>
              <ChipLink href={`/tags/${tag.id}/`} label={tag.label} count={countByTag(tag.id)} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
