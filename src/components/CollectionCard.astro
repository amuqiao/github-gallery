---
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import type { Collection } from "@/lib/catalog/collections";
import { getPublicationStatusLabel } from "@/presentation/publication-status-labels";
import type { CollectionGridVariant } from "@/presentation/types";

interface Props {
  collection: Collection;
  headingLevel?: 2 | 3;
  variant?: CollectionGridVariant;
}

const { collection, headingLevel = 3, variant = "standard" } = Astro.props;
const cardClass = ["collection-card", `collection-card--${variant}`].join(" ");
const publicationStatusLabel = getPublicationStatusLabel(collection.publication_status);
---

<Card as="article" class={cardClass}>
  <div class="collection-card__meta">
    <Badge variant="secondary">{publicationStatusLabel}</Badge>
    <Badge variant="outline">{collection.projectItems.length} projects</Badge>
  </div>
  {
    headingLevel === 3 ? (
      <h3 class="collection-card__title"><a href={collection.route}>{collection.title}</a></h3>
    ) : (
      <h2 class="collection-card__title"><a href={collection.route}>{collection.title}</a></h2>
    )
  }
  <p class="collection-card__summary">{collection.summary}</p>
  <Button class="collection-card__link" href={collection.route} variant="link" ariaLabel={`Open ${collection.title} collection`}>
    View {collection.title}
  </Button>
</Card>
