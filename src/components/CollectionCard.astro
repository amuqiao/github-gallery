---
import type { Collection } from "@/lib/catalog/collections";
import { getPublicationStatusLabel } from "@/presentation/publication-status-labels";
import type { CollectionGridVariant } from "@/presentation/types";

interface Props {
  collection: Collection;
  headingLevel?: 2 | 3;
  variant?: CollectionGridVariant;
}

const { collection, headingLevel = 3, variant = "standard" } = Astro.props;
const cardClass = ["collection-card", `collection-card--${variant}`].join(" ");
const publicationStatusLabel = getPublicationStatusLabel(collection.publication_status);
const names = collection.projectItems.map((item) => item.project.name);
const preview = names.slice(0, 4).join(" · ") + (names.length > 4 ? ` · +${names.length - 4}` : "");
---

<a class={cardClass} href={collection.route} aria-label={`查看 ${collection.title} 专题`}>
  <div class="collection-card__meta">
    <span class="collection-card__kind"><span aria-hidden="true">✦</span> 专题</span>
    <span class="collection-card__count">{collection.projectItems.length} 个项目 · {publicationStatusLabel}</span>
  </div>
  {
    headingLevel === 3 ? (
      <h3 class="collection-card__title">{collection.title}</h3>
    ) : (
      <h2 class="collection-card__title">{collection.title}</h2>
    )
  }
  <p class="collection-card__summary">{collection.summary}</p>
  <p class="collection-card__members">{preview}</p>
  <span class="collection-card__link">
    查看专题 →
  </span>
</a>
