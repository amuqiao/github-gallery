---
import type { Project, TaxonomyItem } from "@/lib/catalog/projects";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";

interface Props {
  project: Project;
  category: TaxonomyItem;
  tags: TaxonomyItem[];
  note?: string;
  headingLevel?: 2 | 3;
}

const { project, category, tags, note, headingLevel = 2 } = Astro.props;
---

<Card as="article" class="flex min-h-72 flex-col gap-3.5 p-4">
  <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
    <Badge href={`/categories/${category.id}/`} variant="secondary">{category.name}</Badge>
    <Badge variant="outline">{project.status}</Badge>
  </div>
  {
    headingLevel === 3 ? (
      <h3 class="m-0 text-lg font-semibold leading-tight"><a class="no-underline hover:text-primary" href={project.route}>{project.name}</a></h3>
    ) : (
      <h2 class="m-0 text-lg font-semibold leading-tight"><a class="no-underline hover:text-primary" href={project.route}>{project.name}</a></h2>
    )
  }
  <p class="m-0 text-sm text-muted-foreground">{project.summary}</p>
  {note && <p class="m-0 border-l-2 border-primary/40 pl-3 text-sm text-foreground">{note}</p>}
  <div class="flex flex-wrap gap-1.5" aria-label="Tags">
    {tags.map((tag) => <Badge href={`/tags/${tag.id}/`} variant="secondary">{tag.name}</Badge>)}
  </div>
  <Button class="mt-auto justify-start px-0" href={project.repo} variant="link" ariaLabel={`Open ${project.name} repository`}>
    Repository
  </Button>
</Card>
