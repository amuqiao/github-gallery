---
import type { Project, TaxonomyItem } from "@/lib/catalog/projects";

interface Props {
  project: Project;
  category: TaxonomyItem;
  tags: TaxonomyItem[];
}

const { project, category, tags } = Astro.props;
---

<article class="project-card">
  <div class="project-card__meta">
    <a class="project-card__category" href={`/categories/${category.id}/`}>{category.name}</a>
    <span>{project.status}</span>
  </div>
  <h2><a href={project.route}>{project.name}</a></h2>
  <p>{project.summary}</p>
  <div class="project-card__tags" aria-label="Tags">
    {tags.map((tag) => <a href={`/tags/${tag.id}/`}>{tag.name}</a>)}
  </div>
  <a class="project-card__repo" href={project.repo}>Repository</a>
</article>
