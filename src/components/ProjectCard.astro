---
import type { LocalizedProjectMaintenanceStatusItem, LocalizedTaxonomyItem, Project } from "@/lib/catalog/projects";
import type { ProjectCollectionVariant } from "@/presentation/types";

interface Props {
  project: Project;
  category: LocalizedTaxonomyItem;
  tags: LocalizedTaxonomyItem[];
  maintenanceStatus: LocalizedProjectMaintenanceStatusItem;
  note?: string;
  headingLevel?: 2 | 3;
  variant?: ProjectCollectionVariant | "feature";
  order?: number;
}

const { project, category, tags, note, headingLevel = 3, variant = "standard", order } = Astro.props;
const cardClass = ["project-card", `project-card--${variant}`].join(" ");
const primaryLanguage = project.meta?.languages?.[0];
const projectMeta = [primaryLanguage, project.meta?.license].filter(Boolean).join(" · ");
---

<a class={cardClass} href={project.route} aria-label={`查看 ${project.name} 详情`}>
  <div class="project-card__top">
    <div class="project-card__title-group">
      {order && <span class="project-card__order">{String(order).padStart(2, "0")}</span>}
      <div>
        {
          headingLevel === 3 ? (
            <h3 class="project-card__title">{project.name}</h3>
          ) : (
            <h2 class="project-card__title">{project.name}</h2>
          )
        }
        <span class="project-card__id">{project.id}</span>
      </div>
    </div>
    <span class="project-card__category">{category.label}</span>
  </div>
  {note && <p class="project-card__note">{note}</p>}
  <p class="project-card__summary">{project.summary}</p>
  <ul class="project-card__tags" aria-label="标签">
    {tags.slice(0, variant === "feature" ? 5 : 4).map((tag) => <li><span class="project-card__tag">{tag.label}</span></li>)}
  </ul>
  <div class="project-card__footer">
    {projectMeta && <span class="project-card__language"><span aria-hidden="true"></span>{projectMeta}</span>}
    <span class="project-card__read">查看详情 →</span>
  </div>
</a>
