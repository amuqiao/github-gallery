---
import ProjectCard from "@/components/ProjectCard.astro";
import EditorialSectionHeader from "@/components/EditorialSectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import type { ProjectCardViewModel } from "@/lib/catalog/project-view-models";
import type { ProjectCollectionVariant } from "@/presentation/types";

interface Props {
  id?: string;
  index?: string;
  title: string;
  description?: string;
  hint?: string;
  items: ProjectCardViewModel[];
  emptyMessage?: string;
  compact?: boolean;
  cardHeadingLevel?: 2 | 3;
  variant?: ProjectCollectionVariant;
  featureFirst?: boolean;
}

const {
  id = "projects",
  index,
  title,
  description,
  hint,
  items,
  emptyMessage = "当前视图暂无项目。",
  compact = false,
  cardHeadingLevel = 3,
  variant = "standard",
  featureFirst = false
} = Astro.props;
const headingId = `${id}-heading`;
const gridClass = [
  "project-collection__grid",
  `project-collection__grid--${compact ? "compact" : variant}`
].join(" ");
---

<section class="gallery-section project-collection" id={id} aria-labelledby={headingId}>
  <EditorialSectionHeader id={headingId} index={index} title={title} hint={hint ?? `${items.length} 个项目`} />
  {description && <p class="gallery-section__description">{description}</p>}
  {
    items.length > 0 ? (
      <div class={gridClass}>
        {
          items.map(({ project, category, tags, maintenanceStatus, note }, index) => (
            <ProjectCard
              project={project}
              category={category}
              tags={tags}
              maintenanceStatus={maintenanceStatus}
              note={note}
              headingLevel={cardHeadingLevel}
              variant={featureFirst && index === 0 ? "feature" : variant}
              order={variant === "ordered" ? index + 1 : undefined}
            />
          ))
        }
      </div>
    ) : (
      <EmptyState message={emptyMessage} />
    )
  }
</section>
