---
import ProjectCard from "@/components/ProjectCard.astro";
import Badge from "@/components/ui/Badge.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { ProjectCardViewModel } from "@/lib/catalog/project-view-models";
import type { ProjectCollectionVariant } from "@/presentation/types";

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  items: ProjectCardViewModel[];
  emptyMessage?: string;
  compact?: boolean;
  cardHeadingLevel?: 2 | 3;
  variant?: ProjectCollectionVariant;
  featureFirst?: boolean;
}

const {
  id = "projects",
  eyebrow,
  title,
  description,
  items,
  emptyMessage = "No projects match this view.",
  compact = false,
  cardHeadingLevel = 3,
  variant = "standard",
  featureFirst = false
} = Astro.props;
const headingId = `${id}-heading`;
const gridClass = [
  "project-collection__grid",
  `project-collection__grid--${compact ? "compact" : variant}`
].join(" ");
---

<section class="gallery-section project-collection" id={id} aria-labelledby={headingId}>
  <div class="gallery-section__head">
    <SectionHeader id={headingId} eyebrow={eyebrow} title={title} description={description} />
    <Badge variant="outline">{items.length} projects</Badge>
  </div>
  {
    items.length > 0 ? (
      <div class={gridClass}>
        {
          items.map(({ project, category, tags, status, note }, index) => (
            <ProjectCard
              project={project}
              category={category}
              tags={tags}
              status={status}
              note={note}
              headingLevel={cardHeadingLevel}
              variant={featureFirst && index === 0 ? "feature" : variant}
              order={variant === "ordered" ? index + 1 : undefined}
            />
          ))
        }
      </div>
    ) : (
      <EmptyState message={emptyMessage} />
    )
  }
</section>
