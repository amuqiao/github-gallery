---
import ProjectCard from "@/components/ProjectCard.astro";
import Badge from "@/components/ui/Badge.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { ProjectCardViewModel } from "@/lib/catalog/project-view-models";

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  items: ProjectCardViewModel[];
  emptyMessage?: string;
  compact?: boolean;
  cardHeadingLevel?: 2 | 3;
}

const {
  id = "projects",
  eyebrow,
  title,
  description,
  items,
  emptyMessage = "No projects match this view.",
  compact = false,
  cardHeadingLevel = 2
} = Astro.props;
const headingId = `${id}-heading`;
---

<section class="grid gap-5 pt-8" id={id} aria-labelledby={headingId}>
  <div class="flex flex-col items-start justify-between gap-3 md:flex-row md:items-end">
    <SectionHeader id={headingId} eyebrow={eyebrow} title={title} description={description} />
    <Badge variant="outline">{items.length} projects</Badge>
  </div>
  {
    items.length > 0 ? (
      <div
        class:list={[
          "grid gap-4",
          compact
            ? "grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))]"
            : "grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))]"
        ]}
      >
        {
          items.map(({ project, category, tags, note }) => (
            <ProjectCard
              project={project}
              category={category}
              tags={tags}
              note={note}
              headingLevel={cardHeadingLevel}
            />
          ))
        }
      </div>
    ) : (
      <EmptyState message={emptyMessage} />
    )
  }
</section>
