---
import type { LocalizedTaxonomyStatusItem } from "@/lib/catalog/projects";
import { getProjectStatusTone } from "@/presentation/status-tones";

interface Props {
  status: LocalizedTaxonomyStatusItem;
  prefix?: string;
  showLabel?: boolean;
  class?: string;
}

const { status, prefix, showLabel = true, class: className } = Astro.props;
const tone = getProjectStatusTone(status.id);
const statusClass = ["project-status", `project-status--${tone}`, className];
const label = `${prefix ?? ""}${status.label}`;
---

<span class:list={statusClass} title={status.descriptionText} aria-label={label}>
  <span class="project-status__dot" aria-hidden="true"></span>
  {showLabel && <span>{label}</span>}
</span>
