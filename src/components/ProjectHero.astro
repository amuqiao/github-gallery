---
import PageHeader from "@/components/PageHeader.astro";
import ProjectStatus from "@/components/ProjectStatus.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import type { LocalizedTaxonomyItem, LocalizedTaxonomyStatusItem, Project } from "@/lib/catalog/projects";

interface Props {
  project: Project;
  category: LocalizedTaxonomyItem;
  tags: LocalizedTaxonomyItem[];
  status: LocalizedTaxonomyStatusItem;
}

const { project, category, tags, status } = Astro.props;
---

<PageHeader eyebrow={category.label} title={project.name} description={project.summary} variant="project" asideLabel="Project actions">
  <Fragment slot="meta">
    <ProjectStatus status={status} prefix="状态：" />
    {project.meta?.license && <span>License: {project.meta.license}</span>}
    {project.meta?.languages && <span>Languages: {project.meta.languages.join(", ")}</span>}
  </Fragment>
  <Fragment slot="footer">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => <Badge href={`/tags/${tag.id}/`} variant="secondary">{tag.label}</Badge>)}
    </div>
  </Fragment>
  <Fragment slot="actions">
    <Button href={project.repo}>Open repository</Button>
    <Button href={`/categories/${category.id}/`} variant="outline">View category</Button>
  </Fragment>
</PageHeader>
