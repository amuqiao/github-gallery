---
import ProjectMaintenanceStatus from "@/components/ProjectMaintenanceStatus.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import type { LocalizedProjectMaintenanceStatusItem, LocalizedTaxonomyItem, Project } from "@/lib/catalog/projects";

interface Props {
  project: Project;
  category: LocalizedTaxonomyItem;
  tags: LocalizedTaxonomyItem[];
  maintenanceStatus: LocalizedProjectMaintenanceStatusItem;
}

const { project, category, tags, maintenanceStatus } = Astro.props;
const primaryLanguage = project.meta?.languages?.[0];
---

<header class="phero">
  <div class="phero__main">
    <span class="phero__eyebrow">项目</span>
    <h1 class="phero__name">{project.name}</h1>
    <p class="phero__repo">{project.repo}</p>
    <p class="phero__summary">{project.summary}</p>
    <ul class="phero__tags">
      {tags.map((tag) => (
        <li>
          <Badge href={`/tags/${tag.id}/`} variant="secondary">{tag.label}</Badge>
        </li>
      ))}
    </ul>
    <Button href={project.repo}>打开仓库</Button>
  </div>
  <Card as="aside" class="phero__facts">
    <dl class="phero__facts-list">
      <div class="phero__fact">
        <dt class="phero__fact-label">分类</dt>
        <dd class="phero__fact-value"><a href={`/categories/${category.id}/`}>{category.label}</a></dd>
      </div>
      {
        primaryLanguage && (
          <div class="phero__fact">
            <dt class="phero__fact-label">主要语言</dt>
            <dd class="phero__fact-value">{primaryLanguage}</dd>
          </div>
        )
      }
      {
        project.meta?.license && (
          <div class="phero__fact">
            <dt class="phero__fact-label">许可证</dt>
            <dd class="phero__fact-value">{project.meta.license}</dd>
          </div>
        )
      }
      <div class="phero__fact">
        <dt class="phero__fact-label">维护状态</dt>
        <dd class="phero__fact-value"><ProjectMaintenanceStatus maintenanceStatus={maintenanceStatus} /></dd>
      </div>
      <div class="phero__fact">
        <dt class="phero__fact-label">ID</dt>
        <dd class="phero__fact-value">{project.id}</dd>
      </div>
    </dl>
  </Card>
</header>
