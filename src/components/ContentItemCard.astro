---
import type { ContentItem } from "@/lib/catalog/content";
import { getCategory, getTag, getTaxonomyCatalog } from "@/lib/catalog/projects";

interface Props {
  item: ContentItem;
  note?: string;
  headingLevel?: 2 | 3;
  order?: number;
}

const { item, note, headingLevel = 3, order } = Astro.props;
const profile = item.profile;
const isAiModel = "provider" in profile;
const sourceLabel = item.source.type;
let kindLabel: string;
let primaryFacts: string[];
let tagPreview: string[];

if (isAiModel) {
  kindLabel = "模型";
  primaryFacts = [profile.provider, profile.formats.join(" · "), profile.runtimes.join(" · ")];
  tagPreview = profile.tasks.slice(0, 4);
} else {
  const taxonomy = await getTaxonomyCatalog();
  kindLabel = getCategory(taxonomy, profile.category).label;
  primaryFacts = [profile.languages?.[0], profile.license].filter((fact): fact is string => Boolean(fact));
  tagPreview = profile.tags.slice(0, 4).map((tag) => getTag(taxonomy, tag).label);
}
---

<a class="project-card" href={item.route} aria-label={`查看 ${item.title} 详情`}>
  <div class="project-card__top">
    <div class="project-card__title-group">
      {order && <span class="project-card__order">{String(order).padStart(2, "0")}</span>}
      <div>
        {
          headingLevel === 3 ? (
            <h3 class="project-card__title">{item.title}</h3>
          ) : (
            <h2 class="project-card__title">{item.title}</h2>
          )
        }
        <span class="project-card__id">{item.id}</span>
      </div>
    </div>
    <span class="project-card__category">{kindLabel}</span>
  </div>
  {note && <p class="project-card__note">{note}</p>}
  <p class="project-card__summary">{item.summary}</p>
  <ul class="project-card__tags" aria-label="标签">
    {tagPreview.map((tag) => <li><span class="project-card__tag">{tag}</span></li>)}
  </ul>
  <div class="project-card__footer">
    <span class="project-card__language"><span aria-hidden="true"></span>{primaryFacts.filter(Boolean).join(" · ") || sourceLabel}</span>
    <span class="project-card__read">查看详情 →</span>
  </div>
</a>
