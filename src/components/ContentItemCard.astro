---
import type { ContentItem } from "@/lib/catalog/content";
import { projectContentItemCard } from "@/lib/catalog/projections";
import { getTaxonomyCatalog } from "@/lib/catalog/taxonomy";
import HoverCardLink from "@/components/ui/HoverCardLink.astro";

interface Props {
  item: ContentItem;
  note?: string;
  headingLevel?: 2 | 3;
  order?: number;
}

const { item, note, headingLevel = 3, order } = Astro.props;
const taxonomy = item.kind === "github_project" ? await getTaxonomyCatalog() : undefined;
const card = projectContentItemCard(item, taxonomy);
---

<HoverCardLink class="project-card" tone="item" href={item.route} aria-label={`查看 ${item.title} 详情`}>
  <div class="project-card__top">
    <div class="project-card__title-group">
      {order && <span class="project-card__order">{String(order).padStart(2, "0")}</span>}
      <div>
        {
          headingLevel === 3 ? (
            <h3 class="project-card__title">{item.title}</h3>
          ) : (
            <h2 class="project-card__title">{item.title}</h2>
          )
        }
        <span class="project-card__id">{item.id}</span>
      </div>
    </div>
    <span class="project-card__category">{card.kindLabel}</span>
  </div>
  {note && <p class="project-card__note">{note}</p>}
  <p class="project-card__summary">{item.summary}</p>
  <ul class="project-card__tags" aria-label="标签">
    {card.tagPreview.map((tag) => <li><span class="project-card__tag">{tag}</span></li>)}
  </ul>
  <div class="project-card__footer">
    <span class="project-card__language"><span aria-hidden="true"></span>{card.footerText}</span>
    <span class="project-card__read">查看详情 →</span>
  </div>
</HoverCardLink>
