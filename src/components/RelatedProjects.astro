---
import ProjectCollection from "@/components/ProjectCollection.astro";
import type { Project, TaxonomyCatalog } from "@/lib/catalog/projects";

interface Props {
  projects: Project[];
  taxonomy: TaxonomyCatalog;
}

const { projects, taxonomy } = Astro.props;
---

{
  projects.length > 0 && (
    <ProjectCollection
      id="related-projects"
      eyebrow="Related"
      title="Related projects"
      projects={projects}
      taxonomy={taxonomy}
      compact
      cardHeadingLevel={3}
    />
  )
}
