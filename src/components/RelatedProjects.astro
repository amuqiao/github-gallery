---
import ProjectCollection from "@/components/ProjectCollection.astro";
import type { ProjectCardViewModel } from "@/lib/catalog/project-view-models";
import { getActivePresentation } from "@/presentation";

interface Props {
  items: ProjectCardViewModel[];
}

const { items } = Astro.props;
const { layout } = getActivePresentation();
---

{
  items.length > 0 && (
    <ProjectCollection
      id="related-projects"
      eyebrow="Related"
      title="Related projects"
      items={items}
      compact
      cardHeadingLevel={3}
      variant={layout.detailPages.relatedProjectCollectionVariant}
    />
  )
}
