---
import ProjectCollection from "@/components/ProjectCollection.astro";
import type { ProjectCardViewModel } from "@/lib/catalog/project-view-models";

interface Props {
  items: ProjectCardViewModel[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ProjectCollection
      id="related-projects"
      eyebrow="Related"
      title="Related projects"
      items={items}
      compact
      cardHeadingLevel={3}
    />
  )
}
