---
import type { LocalizedProjectMaintenanceStatusItem } from "@/lib/catalog/projects";
import { getProjectMaintenanceStatusTone } from "@/presentation/maintenance-status-tones";

interface Props {
  maintenanceStatus: LocalizedProjectMaintenanceStatusItem;
  prefix?: string;
  showLabel?: boolean;
  class?: string;
}

const { maintenanceStatus, prefix, showLabel = true, class: className } = Astro.props;
const tone = getProjectMaintenanceStatusTone(maintenanceStatus.id);
const statusClass = ["project-maintenance-status", `project-maintenance-status--${tone}`, className];
const label = `${prefix ?? ""}${maintenanceStatus.label}`;
---

<span class:list={statusClass} title={maintenanceStatus.descriptionText} aria-label={label}>
  <span class="project-maintenance-status__dot" aria-hidden="true"></span>
  {showLabel && <span>{label}</span>}
</span>
