---
import CollectionGrid from "@/components/CollectionGrid.astro";
import FilterPanel from "@/components/FilterPanel.astro";
import HomeBentoHero from "@/components/HomeBentoHero.astro";
import ProjectCollection from "@/components/ProjectCollection.astro";
import type { Collection } from "@/lib/catalog/collections";
import type { LocalizedTaxonomyItem, Project } from "@/lib/catalog/projects";
import type { ProjectCardViewModel } from "@/lib/catalog/project-view-models";
import type { HomeSectionId, PresentationHomeConfig, PresentationLayout } from "@/presentation/types";

interface Props {
  layout: PresentationLayout;
  home: PresentationHomeConfig;
  projects: Project[];
  collections: Collection[];
  activeCategories: LocalizedTaxonomyItem[];
  activeTags: LocalizedTaxonomyItem[];
  projectItems: ProjectCardViewModel[];
}

const { layout, home, projects, collections, activeCategories, activeTags, projectItems } = Astro.props;
const featuredCollection = collections.find((collection) => collection.id === home.featuredCollectionId);

if (!featuredCollection) {
  throw new Error(`Configured featured collection not found: ${home.featuredCollectionId}`);
}
---

<HomeBentoHero
  featuredCollection={featuredCollection}
  projectCount={projects.length}
  collectionCount={collections.length}
  categoryCount={activeCategories.length}
  tagCount={activeTags.length}
/>

{
  layout.home.sectionOrder.map((section: HomeSectionId) =>
    section === "collections" ? (
      <CollectionGrid
        id="collections"
        eyebrow="Curated"
        title="Project collections"
        description="专题是人工整理的项目集，适合把同一批 GitHub 项目按声音克隆、多语言 TTS 等目标重新组织。"
        collections={collections}
        cardHeadingLevel={3}
        variant={layout.home.collectionGridVariant}
      />
    ) : section === "filters" ? (
      <FilterPanel
        categories={activeCategories}
        tags={activeTags}
        projects={projects}
        variant={layout.home.filterPanelVariant}
      />
    ) : (
      <ProjectCollection
        id="projects"
        eyebrow="Collection"
        title="All projects"
        description="同一批项目通过稳定合同进入页面，卡片、筛选页和详情页都消费统一 read model。"
        items={projectItems}
        variant={layout.home.projectCollectionVariant}
        featureFirst={layout.home.featureFirstProject}
      />
    )
  )
}
